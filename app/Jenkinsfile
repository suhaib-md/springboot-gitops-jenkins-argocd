// CI pipeline for the backend app. Configure the Jenkins job as
// "Pipeline script from SCM" -> this repo, Script Path: app/Jenkinsfile.
pipeline {
    agent any

    parameters {
        string(name: 'REGISTRY_HOST', defaultValue: 'registry.example.com:5000',
               description: 'Nexus Docker (hosted) registry host:port, e.g. nexus.lab.local:5000')
    }

    environment {
        IMAGE_NAME   = "backend-app"
        IMAGE_TAG    = "v${BUILD_NUMBER}"
        FULL_IMAGE   = "${params.REGISTRY_HOST}/${IMAGE_NAME}:${IMAGE_TAG}"
        APP_DIR      = "app"                      // Docker build context (contains the Dockerfile)
        MANIFEST     = "k8s/deployment.yaml"      // file ArgoCD watches; the image tag is bumped here
        GITOPS_REPO  = "github.com/suhaib-md/springboot-gitops-jenkins-argocd.git"
        GITOPS_BRANCH = "main"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // second argument = build context
                    docker.build("${IMAGE_NAME}:${IMAGE_TAG}", "${APP_DIR}")
                }
            }
        }

        stage('Push Docker Image to Nexus') {
            steps {
                script {
                    // TODO: create a Jenkins "Username with password" credential for your Nexus
                    // Docker registry and put its ID here (was: nexus-docker-credentials).
                    docker.withRegistry("http://${params.REGISTRY_HOST}", 'nexus-docker-credentials') {
                        docker.image("${IMAGE_NAME}:${IMAGE_TAG}").push()
                    }
                }
            }
        }

        stage('Bump Image Tag in k8s/') {
            environment {
                // TODO: create a Jenkins "Secret text" credential holding a GitHub token with
                // write access to this repo and put its ID here (was: github-token).
                TOKEN = credentials('github-token')
            }
            steps {
                sh '''
                set -e
                rm -rf gitops && git clone --branch "$GITOPS_BRANCH" "https://$GITOPS_REPO" gitops
                cd gitops
                git config user.name  "jenkins"
                git config user.email "jenkins@ci.local"
                git checkout -b "update-image-$BUILD_NUMBER"
                sed -i "s|image: .*|image: $FULL_IMAGE|" "$MANIFEST"
                git add "$MANIFEST"
                # [skip ci]: this commit only touches k8s/, it must not re-trigger this pipeline
                git commit -m "chore(k8s): update image to $IMAGE_NAME:$IMAGE_TAG [skip ci]" || { echo "No changes to commit"; exit 0; }
                git push "https://$TOKEN@$GITOPS_REPO" "update-image-$BUILD_NUMBER"
                '''
                // Opens a branch; merge it (PR) to main and ArgoCD syncs the new tag.
            }
        }
    }
}
