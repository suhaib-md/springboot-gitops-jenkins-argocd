// Maven build -> Nexus pipeline. Configure the Jenkins job as
// "Pipeline script from SCM" -> this repo, Script Path: nexus-maven-pipeline/Jenkinsfile.
pipeline {
    agent any

    parameters {
        string(name: 'NEXUS_URL', defaultValue: 'localhost:8090',
               description: 'Nexus host:port (no scheme)')
    }
    
    tools {
        maven 'Maven-3.9.0'
        jdk 'OpenJDK-17'
    }
    
    environment {
        // Nexus and GitHub info
        NEXUS_VERSION = "nexus3"
        NEXUS_PROTOCOL = "http"
        NEXUS_URL = "${params.NEXUS_URL}"
        NEXUS_REPOSITORY = "maven-snapshots"
        // TODO: create a Jenkins "Username with password" credential for Nexus and put its ID here
        NEXUS_CREDENTIAL_ID = "nexus-credentials"
        PROJECT_DIR = "nexus-maven-pipeline"   // this project's folder inside the repo
        
        // POM details (manually entered to avoid security sandbox issues)
        ARTIFACT_ID = "hello-world-spring-boot"
        GROUP_ID = "com.example"
        VERSION = "1.0.0-SNAPSHOT"
        PACKAGING = "jar"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code from GitHub...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application...'
                dir(PROJECT_DIR) { sh 'mvn clean compile' }
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                dir(PROJECT_DIR) { sh 'mvn test' }
            }
            post {
                always {
                    junit testResults: "${PROJECT_DIR}/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('Package') {
            steps {
                echo 'Packaging the application...'
                dir(PROJECT_DIR) { sh 'mvn package -DskipTests' }
            }
            post {
                success {
                    archiveArtifacts artifacts: "${PROJECT_DIR}/target/*.jar", fingerprint: true
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo 'Deploying artifacts to Nexus...'
                script {
                    def repositoryName = VERSION.endsWith("SNAPSHOT") ? "maven-snapshots" : "maven-releases"
                    def artifactPath = "${PROJECT_DIR}/target/${ARTIFACT_ID}-${VERSION}.${PACKAGING}"

                    if (!fileExists(artifactPath)) {
                        error "Artifact file not found: ${artifactPath}"
                    }

                    nexusArtifactUploader(
                        nexusVersion: NEXUS_VERSION,
                        protocol: NEXUS_PROTOCOL,
                        nexusUrl: NEXUS_URL,
                        groupId: GROUP_ID,
                        version: VERSION,
                        repository: repositoryName,
                        credentialsId: NEXUS_CREDENTIAL_ID,
                        artifacts: [
                            [
                                artifactId: ARTIFACT_ID,
                                classifier: '',
                                file: artifactPath,
                                type: PACKAGING
                            ],
                            [
                                artifactId: ARTIFACT_ID,
                                classifier: '',
                                file: "${PROJECT_DIR}/pom.xml",
                                type: "pom"
                            ]
                        ]
                    )
                    echo "Artifact deployed successfully to Nexus"
                }
            }
        }

        stage('Integration Tests') {
            steps {
                echo 'Running integration tests...'
                dir(PROJECT_DIR) { sh 'mvn verify -DskipUTs' }
            }
        }
    }

    post {
        always {
            echo 'Cleaning workspace...'
            cleanWs()
        }
        success {
            echo 'Pipeline executed successfully!'
            // Optional email notification
            /*
            emailext(
                subject: "SUCCESS: Job '${env.JOB_NAME} ${env.BUILD_NUMBER}'",
                body: "Good news! The build ${env.BUILD_URL} completed successfully.",
                to: "${env.CHANGE_AUTHOR_EMAIL}"
            )
            */
        }
        failure {
            echo 'Pipeline failed!'
            // Optional email notification
            /*
            emailext(
                subject: "FAILED: Job '${env.JOB_NAME} ${env.BUILD_NUMBER}'",
                body: "Build failed. Check console output at ${env.BUILD_URL}",
                to: "${env.CHANGE_AUTHOR_EMAIL}"
            )
            */
        }
    }
}
